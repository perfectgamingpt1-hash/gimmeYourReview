<% layout("layouts/boilerplate") %>
  <div class="row mt-3">
    <div class="col-8 offset-2">
      <h3>Edit your Listing</h3>
      <form action="/listings/<%= listing._id %>?_method=PUT" method="post" novalidate class="needs-validation"
        enctype="multipart/form-data">
        <div class="mb-3 mt-3">
          <label for="title" class="form-label">Title</label>
          <input class="form-control" required type="text" name="listing[title]" value="<%= listing.title %>"
            id="title" />
          <div class="invalid-feedback">Please enter a valid Title</div>
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" required type="text" name="listing[description]">
<%= listing.description %>
    </textarea>
            <div class="invalid-feedback">Please enter a valid description</div>
          </div>

          <div class="mb-3">
            Original listing Image <br>
            <img src="<%= orgImg %>" alt="Image">
          </div>

          <div class="mb-3">
            <label for="image" class="form-label">Upload new Image</label>
            <input id="image" class="form-control" type="file" name="image">
          </div>
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input required class="form-control" type="number" name="listing[price]" value="<%= listing.price %>"
              id="" />
            <div class="invalid-feedback">Please enter a valid price</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input required class="form-control" type="text" name="listing[country]" value="<%= listing.country %>"
              id="" />
            <div class="invalid-feedback">Please enter a valid Country</div>
          </div>
          <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input required class="form-control" type="text" name="listing[location]" value="<%= listing.location %>"
              id="" />
            <div class="invalid-feedback">Please enter a valid Location</div>
          </div>
          <div class="mb-3">
            <label for="category" class="form-label"><b>Category</b></label>
            <select id="category" name="listing[category]" class="form-select" required>
              <option value="" disabled selected>Choose One of These</option>
              <option value="Trending">Trending</option>
              <option value="Camping">Camping</option>
            </select>
            <div class="invalid-feedback">Please select a category.</div>
          </div>
          <button type="submit" class="btn btn-dark mt-3">Save</button>
      </form>
    </div>
  </div>
  <br /><br /><br />
  <hr />
  <br />